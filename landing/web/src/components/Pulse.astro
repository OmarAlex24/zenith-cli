---
// Pulse: read-only activity heatmap (53 weeks x 7 days, blue ramp).
---
<section id="pulse" style="padding:8px 0 96px">
  <div class="wrap">
    <div class="panel reveal" style="padding:44px 40px">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:18px;margin-bottom:30px">
        <div style="max-width:48ch">
          <span class="eyebrow mono">Self-tracking telemetry</span>
          <h2 style="font-size:clamp(1.7rem,3vw,2.4rem);margin-top:16px">Your work, measured locally.</h2>
          <p style="margin-top:16px;color:var(--subtle);font-size:1.02rem;max-width:46ch">
            Every brief, plan, decision, and session is an event. Pulse rolls 53 weeks of activity into a read-only heatmap. Standup, drift, and adherence read the same log. Nothing leaves your machine.
          </p>
        </div>
        <div class="mono" style="display:flex;align-items:center;gap:10px;color:var(--faint);font-size:12px">
          less <span style="display:flex;gap:3px"><span style="width:11px;height:11px;background:#1a2030"></span><span style="width:11px;height:11px;background:#15324f"></span><span style="width:11px;height:11px;background:#1d4f80"></span><span style="width:11px;height:11px;background:#2f7fc4"></span><span style="width:11px;height:11px;background:#4ba0fa"></span></span> more
        </div>
      </div>
      <div style="overflow-x:auto;padding-bottom:6px">
        <div id="heatmap" class="heat" data-heatmap></div>
      </div>
      <div style="margin-top:22px;display:flex;gap:34px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:22px">
        <div class="mono"><span class="c-blue">timeline</span> <span style="color:var(--faint)">read-only event log</span></div>
        <div class="mono"><span class="c-blue">standup</span> <span style="color:var(--faint)">daily digest</span></div>
        <div class="mono"><span class="c-blue">drift</span> <span style="color:var(--faint)">roadmap vs plan</span></div>
        <div class="mono"><span class="c-blue">adherence</span> <span style="color:var(--faint)">velocity</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pulse heatmap: 53 weeks x 7 days, blue ramp (deterministic seeded fill).
  const host = document.querySelector<HTMLElement>('[data-heatmap]');
  if (host) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ramp = ['#1a2030', '#15324f', '#1d4f80', '#2f7fc4', '#4ba0fa'];
    let seed = 1337;
    const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
    const total = 53 * 7;
    const cells: HTMLSpanElement[] = [];
    for (let i = 0; i < total; i++) {
      const r = rnd();
      const lvl = r < 0.46 ? 0 : r < 0.68 ? 1 : r < 0.85 ? 2 : r < 0.95 ? 3 : 4;
      const s = document.createElement('span');
      s.style.background = ramp[lvl];
      if (!reduce) { s.style.opacity = '0'; s.style.transition = 'opacity .5s ease'; }
      host.appendChild(s);
      cells.push(s);
    }
    if (!reduce) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            cells.forEach((c, idx) => setTimeout(() => { c.style.opacity = '1'; }, Math.floor(idx / 7) * 9));
            io.disconnect();
          }
        });
      }, { threshold: 0.2 });
      io.observe(host);
    }
  }
</script>

---
// Divided grid of the six semantic memory types.
const types = [
  { glyph: '▦', name: 'brief',    desc: 'Stable project intent. Why the project exists, captured once and kept current.' },
  { glyph: '◈', name: 'roadmap',  desc: 'Long-running product or technical direction, with items that become real plans.' },
  { glyph: '●', name: 'plan',     desc: 'Executable phased work being done now, with dependencies and evidence per phase.' },
  { glyph: '◆', name: 'spike',    desc: 'A bounded investigation to reduce uncertainty before committing to a plan.' },
  { glyph: '◉', name: 'decision', desc: 'A technical or strategic choice, recorded with its context so it stays auditable.' },
  { glyph: '△', name: 'finding',  desc: 'A bug, risk, debt, or gap, linked to the plan or phase it touches.' },
];
---
<section id="memory" style="padding:104px 0 96px">
  <div class="wrap">
    <div class="reveal" style="max-width:60ch;margin-bottom:44px">
      <span class="eyebrow mono">Structured memory</span>
      <h2 style="font-size:clamp(2rem,3.6vw,2.9rem);margin-top:16px">One CLI, every kind of project memory.</h2>
      <p style="margin-top:18px;color:var(--subtle);font-size:1.05rem;max-width:54ch">
        Not freeform notes. Six semantic types your agents read and write through stable JSON commands, stored locally in SQLite.
      </p>
    </div>

    <div class="divide-grid mtypes reveal" style="grid-template-columns:repeat(3,1fr)">
      {types.map((t) => (
        <div class="cell">
          <div class="mono" style="color:var(--accent);font-size:18px">{t.glyph} {t.name}</div>
          <p style="margin-top:12px;color:var(--muted);font-size:14.5px">{t.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
// Footer: logo + wordmark, mono link columns, MIT line.
---
<footer style="border-top:1px solid var(--border);padding:56px 0 48px">
  <div class="wrap">
    <div class="footcols" style="display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px">
      <div>
        <div style="display:flex;align-items:center;gap:10px">
          <img src="/assets/zenith-logo-white-cropped.png" alt="Zenith" style="height:20px;width:auto" />
          <span style="font-weight:500;font-size:16px">Zenith</span>
        </div>
        <p style="margin-top:16px;color:var(--faint);font-size:13.5px;max-width:34ch">
          Local-first project memory and agent coordination for developers using AI coding agents.
        </p>
      </div>
      <div>
        <div class="mono" style="font-size:12px;color:var(--faint);letter-spacing:.06em;margin-bottom:14px">PRODUCT</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <a class="link" href="#memory">Memory types</a>
          <a class="link" href="#engine">Plan engine</a>
          <a class="link" href="#pulse">Pulse</a>
          <a class="link" href="#install">Install</a>
        </div>
      </div>
      <div>
        <div class="mono" style="font-size:12px;color:var(--faint);letter-spacing:.06em;margin-bottom:14px">AGENTS</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <a class="link" href="#">zenith-memory</a>
          <a class="link" href="#">zenith-pr-review</a>
          <a class="link" href="#">Codex pack</a>
          <a class="link" href="#">Claude pack</a>
        </div>
      </div>
      <div>
        <div class="mono" style="font-size:12px;color:var(--faint);letter-spacing:.06em;margin-bottom:14px">PROJECT</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <a class="link" href="https://github.com" target="_blank" rel="noopener">GitHub</a>
          <a class="link" href="#">Docs</a>
          <a class="link" href="#">Storage policy</a>
          <a class="link" href="#">License</a>
        </div>
      </div>
    </div>
    <div style="margin-top:44px;border-top:1px solid var(--border);padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <span class="mono" style="color:var(--faint);font-size:12.5px">zenith-cli</span>
      <span class="mono" style="color:var(--faint);font-size:12.5px">MIT licensed. Runs locally.</span>
    </div>
  </div>
</footer>

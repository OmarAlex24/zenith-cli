---
/*
  HeroShader - subtle dot-field backdrop for the hero.

  Reference: the supermemory "Personal Supermemory" card - a still dithering of
  faint dots with blue accents clustered toward the edges, fading out behind the
  text. Essentially motionless (a barely-perceptible drift only).

  Implementation: a self-contained WebGL1 fragment shader. Chosen over a library
  for reliability (no WebGPU-beta dependency), exact control, and tiny weight.
  WebGL has ~universal support; if the context is unavailable, the canvas stays
  empty and the CSS .grid-bg fallback (rendered behind it) shows through.

  ── SWAP POINT ─────────────────────────────────────────────────────────────
  To trade this for a component library, replace this file's <canvas> + <script>
  with a framework island and add the client directive on <HeroShader/> usage:

    paper-design (recommended - ships the exact "dithering" primitive):
      npm i @paper-design/shaders-react   + @astrojs/react
      ---
      import { Dithering } from '@paper-design/shaders-react';
      ---
      <Dithering client:visible className="hero-canvas"
        colorBack="#0b1119" colorFront="#4ba0fa" shape="dots"
        type="random" pxSize={2} speed={0.15} />

    shaders.com (public beta, WebGPU - verify WebGL fallback first):
      npm i shaders   (React build)
      <Shader client:visible className="hero-canvas"> ...primitive... </Shader>

  Keep className="hero-canvas" so the existing absolute-positioning CSS applies.
  ───────────────────────────────────────────────────────────────────────────
*/
---
<canvas class="hero-canvas" data-hero-shader aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-shader]');
  if (canvas) initDotField(canvas);

  function initDotField(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: true });
    if (!gl) return; // no WebGL -> CSS .grid-bg fallback shows through

    const VERT = `
      attribute vec2 a_pos;
      void main(){ gl_Position = vec4(a_pos, 0.0, 1.0); }
    `;
    // Dot-field: aspect-correct grid of dots, faint base + blue accents biased
    // to the edges via value noise, with a radial center fade. Near-still drift.
    const FRAG = `
      precision highp float;
      uniform vec2  u_res;
      uniform float u_time;

      float hash(vec2 p){
        p = fract(p * vec2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
      }
      float noise(vec2 p){
        vec2 i = floor(p), f = fract(p);
        float a = hash(i), b = hash(i + vec2(1.0,0.0));
        float c = hash(i + vec2(0.0,1.0)), d = hash(i + vec2(1.0,1.0));
        vec2 u = f*f*(3.0 - 2.0*f);
        return mix(mix(a,b,u.x), mix(c,d,u.x), u.y);
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        float aspect = u_res.x / u_res.y;
        vec2 auv = vec2(uv.x * aspect, uv.y);

        // dot grid
        float scale = 46.0;
        vec2 g  = auv * scale;
        vec2 id = floor(g);
        vec2 gv = fract(g) - 0.5;
        float d = length(gv);
        float r = 0.085;
        float dot = smoothstep(r, r * 0.35, d);

        // radial mask: faint at center (behind headline), present at edges
        vec2 c = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);
        float edge = smoothstep(0.16, 0.66, length(c));

        // a slow current of accent that drifts diagonally across the field
        float flow = noise(auv * 2.6 + vec2(u_time * 0.09, u_time * 0.045));
        // per-dot twinkle: each dot blinks on its own phase
        float ph  = hash(id);
        float tw  = 0.45 + 0.55 * sin(u_time * 1.1 + ph * 6.2831);
        float accent = smoothstep(0.52, 0.9, flow) * edge * tw;

        vec3 faint = vec3(0.34, 0.41, 0.55); // faint slate dot
        vec3 acc   = vec3(0.29, 0.63, 0.98); // ~#4ba0fa
        vec3 col   = mix(faint, acc, accent);

        float a = dot * edge * (0.20 + accent * 0.6);
        gl_FragColor = vec4(col * a, a); // premultiplied alpha
      }
    `;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA); // premultiplied
    const uRes = gl.getUniformLocation(prog, 'u_res');
    const uTime = gl.getUniformLocation(prog, 'u_time');

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.floor(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w; canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    };
    const render = (t: number) => {
      resize();
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    render(0); // always paint at least one static frame

    if (!reduce) {
      let raf = 0, visible = true, start = performance.now();
      const loop = () => {
        render((performance.now() - start) / 1000);
        raf = requestAnimationFrame(loop);
      };
      // only animate while the hero is on screen
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !visible) { visible = true; raf = requestAnimationFrame(loop); }
        else if (!e.isIntersecting && visible) { visible = false; cancelAnimationFrame(raf); }
      }, { threshold: 0 });
      io.observe(canvas);
      window.addEventListener('resize', () => render((performance.now() - start) / 1000));
      raf = requestAnimationFrame(loop);
    } else {
      window.addEventListener('resize', () => render(0));
    }
  }
</script>

{
  "name": "zenith-cli",
  "version": "0.1.0",
  "description": "Local-first project memory and agent coordination CLI for AI coding workflows.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "zenith": "./src/index.ts",
    "decode": "./src/index.ts"
  },
  "scripts": {
    "zenith": "bun run src/index.ts",
    "decode": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "ci": "bun run typecheck && bun test && bun run build",
    "build": "bun build ./src/index.ts --target=bun --outdir=dist",
    "compile": "scripts/build-bin.sh",
    "compile:standalone": "bun build --compile ./src/index.ts --outfile dist/zenith-standalone",
    "package:release": "scripts/package-release.sh"
  },
  "dependencies": {
    "@opentui/core": "^0.3.1",
    "@opentui/react": "^0.3.1",
    "commander": "^14.0.2",
    "react": "^19.2.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  }
}
